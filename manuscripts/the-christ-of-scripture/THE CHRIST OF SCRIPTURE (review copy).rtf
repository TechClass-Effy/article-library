\f2\b0\fs33\fsmilli16667 \cf0 \'85O God, God of the spirits and of all flesh, \'85 \'97 
\f0\b Numbers 16:22 LXX, NETS
\f2\b0 \
\pard\pardeftab720\sa346\partightenfactor0

\fs34\fsmilli17333 \cf0 The Father is 
\f0\b "the God of the spirits of all flesh"
\f2\b0  \'97 He is the source and Lord of all spirits. He is Spirit Himself and the originator of every other spirit.\
\pard\pardeftab720\partightenfactor0
