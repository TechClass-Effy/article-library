\fs34\fsmilli17333 \cf0 \uc0\u7969  \u7936 \u947 \u940 \u960 \u951  \u964 \u959 \u8166  \u920 \u949 \u959 \u8166  \u7952 \u954 \u954 \u941 \u967 \u965 \u964 \u945 \u953  \u7952 \u957  \u964 \u945 \u8150 \u962  \u954 \u945 \u961 \u948 \u943 \u945 \u953 \u962  \u7969 \u956 \u8182 \u957 
\f2\b0  \'97 
\f1\i "the love of God has been shed abroad in our hearts."
