\f2\b0 \
\pard\pardeftab720\sa346\partightenfactor0

\f0\b\fs34\fsmilli17333 \cf0 Witness #2 confirmed:
\f2\b0  Jesus was 
\f0\b \uc0\u8001 \u961 \u953 \u963 \u952 \u941 \u957 \u964 \u959 \u962  \u933 \u7985 \u959 \u8166  \u920 \u949 \u959 \u8166 
\f2\b0  \'97 
\f1\i "declared/appointed Son of God in power"
\f2\i0  \'97 
\f0\b \uc0\u7952 \u958  \u7936 \u957 \u945 \u963 \u964 \u940 \u963 \u949 \u969 \u962  \u957 \u949 \u954 \u961 \u8182 \u957 
