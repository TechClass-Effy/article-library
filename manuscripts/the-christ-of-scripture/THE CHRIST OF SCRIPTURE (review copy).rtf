\f2\b0  \'97 
\f1\i "I am the Alpha and the Omega."
\f2\i0 \
- 
\f0\b \uc0\u7969  \u7936 \u961 \u967 \u8052  \u954 \u945 \u8054  \u964 \u8056  \u964 \u941 \u955 \u959 \u962 
\f2\b0  \'97 
\f1\i "the Beginning and the End."
\f2\i0 \
- 
\f0\b \uc0\u7956 \u963 \u959 \u956 \u945 \u953  \u945 \u8016 \u964 \u8183  \u920 \u949 \u8056 \u962  \u954 \u945 \u8054  \u945 \u8016 \u964 \u8056 \u962  \u7956 \u963 \u964 \u945 \u953  \u956 \u959 \u953  \u965 \u7985 \u972 \u962 
\f2\b0  \'97 
\f1\i "I will be His God, and he shall be My son."
