\f0\b \uc0\u7952 \u957  \u935 \u961 \u953 \u963 \u964 \u8183  \u7992 \u951 \u963 \u959 \u8166 
\f2\b0  \'97 
\f1\i "in Christ Jesus"
\f2\i0  \'97 the sphere/locus.\
