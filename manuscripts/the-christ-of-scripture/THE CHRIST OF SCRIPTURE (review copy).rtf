\f2\b0 \
- 
\f0\b \uc0\u7952 \u960 \u953 \u946 \u955 \u941 \u968 \u959 \u957 \u964 \u945 \u953  \u960 \u961 \u972 \u962  \u956 \u949  \u7936 \u957 \u952 \u8125  \u8039 \u957  \u954 \u945 \u964 \u969 \u961 \u967 \u942 \u963 \u945 \u957 \u964 \u959 
\f2\b0  \'97 
\f1\i "they shall look upon 
\f3\b Me
