\f1\i\b0\fs34\fsmilli17333 \cf0 "\uc0\u945 \u8021 \u964 \u951  \u948 \u941  \u7952 \u963 \u964 \u953 \u957  \u7969  \u945 \u7984 \u974 \u957 \u953 \u959 \u962  \u950 \u969 \u942 , \u7989 \u957 \u945  \u947 \u953 \u957 \u974 \u963 \u954 \u969 \u963 \u953 \u957  \u963 \u8050  \u964 \u8056 \u957  \u956 \u972 \u957 \u959 \u957  \u7936 \u955 \u951 \u952 \u953 \u957 \u8056 \u957  \u920 \u949 \u8056 \u957  \u954 \u945 \u8054  \u8003 \u957  \u7936 \u960 \u941 \u963 \u964 \u949 \u953 \u955 \u945 \u962  \u7992 \u951 \u963 \u959 \u8166 \u957  \u935 \u961 \u953 \u963 \u964 \u972 \u957 ."
