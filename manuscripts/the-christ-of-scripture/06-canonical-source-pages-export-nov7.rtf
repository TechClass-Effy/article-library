64 \u959  \u954 \u945 \u8054  \u954 \u961 \u949 \u943 \u964 \u964 \u959 \u957 \u959 \u962  \u948 \u953 \u945 \u952 \u942 \u954 \u951 \u962  \u947 \u941 \u947 \u959 \u957 \u949 \u957  \u7956 \u947 \u947 \u965 \u959 \u962  \u7992 \u951 \u963 \u959 \u8166 \u962 ... \u8001  \u948 \u8050  \u948 \u953 \u8048  \u964 \u8056  \u956 \u941 \u957 \u949 \u953 \u957  \u945 \u8016 \u964 \u8056 \u957  \u949 \u7984 \u962  \u964 \u8056 \u957  \u945 \u7984 \u8182 \u957 \u945  \u7936 \u960 \u945 \u961 \u940 \u946 \u945 \u964 \u959 \u957  \u7956 \u967 \u949 \u953  \u964 \u8052 \u957  \u7985 \u949 \u961 \u969 \u963 \u973 \u957 \u951 \u957 \'b7 \u8005 \u952 \u949 \u957  \u954 \u945 \u8054  \u963 \u8180 \u950 \u949 \u953 \u957  \u949 \u7984 \u962  \u964 \u8056  \u960 \u945 \u957 \u964 \u949 \u955 \u8050 \u962  \u948 \u973 \u957 \u945 \u964 \u945 \u953  \u964 \u959 \u8058 \u962  \u960 \u961 \u959 \u963 \u949 \u961 \u967 \u959 \u956 \u941 \u957 \u959 \u965 \u962  \u948 \u953 \u8125  \u945 \u8016 \u964 \u959 \u8166  \u964 \u8183  \u920 \u949 \u8183 , \u960 \u940 \u957 \u964 \u959 \u964 \u949  \u950 \u8182 \u957  \u949 \u7984 \u962  \u964 \u8056  \u7952 \u957 \u964 \u965 \u947 \u967 \u940 \u957 \u949 \u953 \u957  \u8017 \u960 \u8050 \u961  \u945 \u8016 \u964 \u8182 \u957 ."*\
