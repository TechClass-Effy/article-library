*"\uc0\u948 \u961 \u940 \u958 \u945 \u963 \u952 \u949  \u960 \u945 \u953 \u948 \u949 \u943 \u945 \u962 , \u956 \u942 \u960 \u959 \u964 \u949  \u8000 \u961 \u947 \u953 \u963 \u952 \u8135  \u922 \u973 \u961 \u953 \u959 \u962  \u954 \u945 \u8054  \u7936 \u960 \u959 \u955 \u949 \u8150 \u963 \u952 \u949  \u7952 \u958  \u8001 \u948 \u959 \u8166  \u948 \u953 \u954 \u945 \u943 \u945 \u962 . \u8005 \u964 \u945 \u957  \u7952 \u954 \u954 \u945 \u965 \u952 \u8135  \u7952 \u957  \u964 \u940 \u967 \u949 \u953  \u8001  \u952 \u965 \u956 \u8056 \u962  \u945 \u8016 \u964 \u959 \u8166 , \u956 \u945 \u954 \u940 \u961 \u953 \u959 \u953  \u960 \u940 \u957 \u964 \u949 \u962  \u959 \u7985  \u960 \u949 \u960 \u959 \u953 \u952 \u972 \u964 \u949 \u962  \u7952 \u960 \u8125  \u945 \u8016 \u964 \u8183 ."*\
