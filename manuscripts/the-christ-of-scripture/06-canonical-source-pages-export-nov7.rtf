### **Greek (vv. 24-28):**\
*"\uc0\u949 \u7990 \u964 \u945  \u964 \u8056  \u964 \u941 \u955 \u959 \u962 , \u8005 \u964 \u945 \u957  \u960 \u945 \u961 \u945 \u948 \u953 \u948 \u8183  \u964 \u8052 \u957  \u946 \u945 \u963 \u953 \u955 \u949 \u943 \u945 \u957  \u964 \u8183  \u920 \u949 \u8183  \u954 \u945 \u8054  \u928 \u945 \u964 \u961 \u943 , \u8005 \u964 \u945 \u957  \u954 \u945 \u964 \u945 \u961 \u947 \u942 \u963 \u8131  \u960 \u8118 \u963 \u945 \u957  \u7936 \u961 \u967 \u8052 \u957  \u954 \u945 \u8054  \u960 \u8118 \u963 \u945 \u957  \u7952 \u958 \u959 \u965 \u963 \u943 \u945 \u957  \u954 \u945 \u8054  \u948 \u973 \u957 \u945 \u956 \u953 \u957 . \u948 \u949 \u8150  \u947 \u8048 \u961  \u945 \u8016 \u964 \u8056 \u957  \u946 \u945 \u963 \u953 \u955 \u949 \u973 \u949 \u953 \u957  \u7940 \u967 \u961 \u953  \u959 \u8023  \u952 \u8135  \u960 \u940 \u957 \u964 \u945 \u962  \u964 \u959 \u8058 \u962  \u7952 \u967 \u952 \u961 \u959 \u8058 \u962  \u8017 \u960 \u8056  \u964 \u959 \u8058 \u962  \u960 \u972 \u948 \u945 \u962  \u945 \u8016 \u964 \u959 \u8166 . \u7956 \u963 \u967 \u945 \u964 \u959 \u962  \u7952 \u967 \u952 \u961 \u8056 \u962  \u954 \u945 \u964 \u945 \u961 \u947 \u949 \u8150 \u964 \u945 \u953  \u8001  \u952 \u940 \u957 \u945 \u964 \u959 \u962 \'b7 \u960 \u940 \u957 \u964 \u945  \u947 \u8048 \u961  \u8017 \u960 \u941 \u964 \u945 \u958 \u949 \u957  \u8017 \u960 \u8056  \u964 \u959 \u8058 \u962  \u960 \u972 \u948 \u945 \u962  \u945 \u8016 \u964 \u959 \u8166 . \u8005 \u964 \u945 \u957  \u948 \u8050  \u949 \u7988 \u960 \u8131  \u8005 \u964 \u953  \u928 \u940 \u957 \u964 \u945  \u8017 \u960 \u959 \u964 \u941 \u964 \u945 \u954 \u964 \u945 \u953 , \u948 \u8134 \u955 \u959 \u957  \u8005 \u964 \u953  \u7952 \u954 \u964 \u8056 \u962  \u964 \u959 \u8166  \u8017 \u960 \u959 \u964 \u940 \u958 \u945 \u957 \u964 \u959 \u962  \u945 \u8016 \u964 \u8183  \u964 \u8048  \u960 \u940 \u957 \u964 \u945 . \u8005 \u964 \u945 \u957  \u948 \u8050  \u8017 \u960 \u959 \u964 \u945 \u947 \u8135  \u945 \u8016 \u964 \u8183  \u964 \u8048  \u960 \u940 \u957 \u964 \u945 , \u964 \u972 \u964 \u949  \u954 \u945 \u8054  \u945 \u8016 \u964 \u8056 \u962  \u8001  \u933 \u7985 \u8056 \u962  \u8017 \u960 \u959 \u964 \u945 \u947 \u942 \u963 \u949 \u964 \u945 \u953  \u964 \u8183  \u8017 \u960 \u959 \u964 \u940 \u958 \u945 \u957 \u964 \u953  \u945 \u8016 \u964 \u8183  \u964 \u8048  \u960 \u940 \u957 \u964 \u945 , \u7989 \u957 \u945  \u8086  \u8001  \u920 \u949 \u8056 \u962  \u960 \u940 \u957 \u964 \u945  \u7952 \u957  \u960 \u8118 \u963 \u953 \u957 ."*\
