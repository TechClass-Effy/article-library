### **John 15:18-20 (Greek):**\
*"\uc0\u917 \u7984  \u8001  \u954 \u972 \u963 \u956 \u959 \u962  \u8017 \u956 \u8118 \u962  \u956 \u953 \u963 \u949 \u8150 , \u947 \u953 \u957 \u974 \u963 \u954 \u949 \u964 \u949  \u8005 \u964 \u953  \u7952 \u956 \u8050  \u960 \u961 \u8182 \u964 \u959 \u957  \u8017 \u956 \u8182 \u957  \u956 \u949 \u956 \u943 \u963 \u951 \u954 \u949 \u957 . \u949 \u7984  \u7952 \u954  \u964 \u959 \u8166  \u954 \u972 \u963 \u956 \u959 \u965  \u7974 \u964 \u949 , \u8001  \u954 \u972 \u963 \u956 \u959 \u962  \u7938 \u957  \u964 \u8056  \u7988 \u948 \u953 \u959 \u957  \u7952 \u966 \u943 \u955 \u949 \u953 \'b7 \u8005 \u964 \u953  \u948 \u8050  \u7952 \u954  \u964 \u959 \u8166  \u954 \u972 \u963 \u956 \u959 \u965  \u959 \u8016 \u954  \u7952 \u963 \u964 \u941 , \u7936 \u955 \u955 \u8125  \u7952 \u947 \u8060  \u7952 \u958 \u949 \u955 \u949 \u958 \u940 \u956 \u951 \u957  \u8017 \u956 \u8118 \u962  \u7952 \u954  \u964 \u959 \u8166  \u954 \u972 \u963 \u956 \u959 \u965 , \u948 \u953 \u8048  \u964 \u959 \u8166 \u964 \u959  \u956 \u953 \u963 \u949 \u8150  \u8017 \u956 \u8118 \u962  \u8001  \u954 \u972 \u963 \u956 \u959 \u962 . \u956 \u957 \u951 \u956 \u959 \u957 \u949 \u973 \u949 \u964 \u949  \u964 \u959 \u8166  \u955 \u972 \u947 \u959 \u965  \u959 \u8023  \u7952 \u947 \u8060  \u949 \u7990 \u960 \u959 \u957  \u8017 \u956 \u8150 \u957 \'b7 \u927 \u8016 \u954  \u7956 \u963 \u964 \u953 \u957  \u948 \u959 \u8166 \u955 \u959 \u962  \u956 \u949 \u943 \u950 \u969 \u957  \u964 \u959 \u8166  \u954 \u965 \u961 \u943 \u959 \u965  \u945 \u8016 \u964 \u959 \u8166 . \u949 \u7984  \u7952 \u956 \u8050  \u7952 \u948 \u943 \u969 \u958 \u945 \u957 , \u954 \u945 \u8054  \u8017 \u956 \u8118 \u962  \u948 \u953 \u974 \u958 \u959 \u965 \u963 \u953 \u957 \'b7 \u949 \u7984  \u964 \u8056 \u957  \u955 \u972 \u947 \u959 \u957  \u956 \u959 \u965  \u7952 \u964 \u942 \u961 \u951 \u963 \u945 \u957 , \u954 \u945 \u8054  \u964 \u8056 \u957  \u8017 \u956 \u941 \u964 \u949 \u961 \u959 \u957  \u964 \u951 \u961 \u942 \u963 \u959 \u965 \u963 \u953 \u957 ."*\
